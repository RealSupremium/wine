STATICLIB = libffmpeg.a
EXTRAINCL = $(FFMPEG_PE_CFLAGS)
EXTRADEFS = -DHAVE_AV_CONFIG_H -D_WIN32_WINNT=0x0A00

ASMFLAGS = -Pconfig.asm
aarch64_EXTRADEFS = $(aarch64_ASMDEFS)
arm64ec_EXTRADEFS = $(arm64ec_ASMDEFS)
arm_EXTRADEFS = $(arm_ASMDEFS)
i386_EXTRADEFS = $(i386_ASMDEFS)
x86_64_EXTRADEFS = $(x86_64_ASMDEFS)

# list of sources included by others, not actual sources, for make_makefiles
INCLUDES = \
	config.asm \
	config.h \
	config_components.asm \
	default_config.asm \
	libavutil/aarch64/asm.S \
	libavutil/arm/asm.S \
	libavutil/tx_template.c \
	libavutil/x86/x86inc.asm \
	libavutil/x86/x86util.asm

