STATICLIB = libmesa.a
EXTRAINCL = \
	-I$(srcdir)/include \
	-I$(srcdir)/src \
	-I$(srcdir)/src/compiler \
	-I$(srcdir)/src/compiler/glsl \
	-I$(srcdir)/src/compiler/glsl/glcpp \
	-I$(srcdir)/src/compiler/nir \
	-I$(srcdir)/src/compiler/spirv \
	-I$(srcdir)/src/gallium/auxiliary \
