[Version]
Signature="$CHICAGO$"
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Class=System

[Manufacturer]
Wine=mfg_section

[mfg_section]
WinUSB driver=device_section,root\winusb

[device_section.Services]
AddService = wineusb,0x2,svc_section

[svc_section]
Description="WinUSB driver"
DisplayName="WinUSB"
ServiceBinary="%12%\winusb.sys"
LoadOrderGroup="WinePlugPlay"
ServiceType=1
StartType=3
ErrorControl=1
